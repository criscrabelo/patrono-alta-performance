NODE_ENV=development
PORT=3007
DATABASE_URL=postgresql://coevo_app:ALTERE_A_SENHA@localhost:5432/coevo_alta_performance
DATABASE_SSL=false
# A partir de H2 (docs/DECISIONS.md, PROD-H2-01): nao e mais uma senha/codigo global comparado no login
# (isso foi removido). Fora de producao, COEVO_DEMO_PASSWORD e reaproveitada apenas como fonte da senha
# de conveniencia atribuida a usuarios seed/legados de desenvolvimento e teste; COEVO_MFA_CODE nao e mais
# lida em nenhum ponto do runtime (mantida aqui so por compatibilidade de .env existentes).
COEVO_DEMO_PASSWORD=defina-uma-senha-local-forte
COEVO_MFA_CODE=defina-um-codigo-temporario
COEVO_SESSION_MS=3600000
# Obrigatorio para /api/backup. Minimo de 32 caracteres.
# Deve ficar VAZIO neste arquivo de exemplo: um valor preenchido aqui seria
# publico e funcional, tornando os backups decifraveis por qualquer pessoa
# com acesso ao repositorio. Gere um valor unico por ambiente e defina-o
# somente no .env local (nao versionado), por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COEVO_BACKUP_KEY=
# H2 (docs/DECISIONS.md, PROD-H2-01): obrigatoria para cifrar/decifrar o segredo TOTP de MFA em
# repouso (AES-256-GCM). Mesma exigencia de COEVO_BACKUP_KEY acima: minimo de 32 caracteres, deve ficar
# VAZIO neste arquivo de exemplo, gerar um valor unico por ambiente, nunca versionado.
MFA_ENCRYPTION_KEY=
# H2: overrides OPCIONAIS, usados apenas fora de producao (NODE_ENV != production), para a senha/segredo
# TOTP de conveniencia atribuidos a usuarios seed/legados de desenvolvimento e teste. Nunca aplicados
# automaticamente em producao. Deixar vazio usa o valor padrao de desenvolvimento embutido no codigo.
COEVO_SEED_PASSWORD=
COEVO_SEED_TOTP_SECRET=
# H3 (docs/DECISIONS.md, PROD-H3-01): obrigatoria para derivar as chaves de bucket de rate limiting
# (HMAC-SHA256 sobre IP/e-mail/identificador/token — nunca o dado bruto persistido). Mesma exigencia de
# COEVO_BACKUP_KEY/MFA_ENCRYPTION_KEY acima: minimo de 32 caracteres, deve ficar VAZIO neste arquivo de
# exemplo, gerar um valor unico por ambiente, nunca versionado.
RATE_LIMIT_HMAC_KEY=
# H3: numero de saltos de proxy confiaveis na frente desta aplicacao (mesmo modelo do "trust proxy"
# numerico do Express/nginx). Padrao 0 = nenhum proxy confiavel configurado — X-Forwarded-For e SEMPRE
# ignorado, o IP do cliente e sempre o endereco remoto real da conexao TCP. So defina >=1 se este
# processo for alcancavel EXCLUSIVAMENTE atraves de exatamente esse numero de proxies confiaveis (ex.:
# um load balancer gerenciado na frente) — nunca em uma topologia onde a aplicacao tambem recebe
# trafego direto da internet.
TRUST_PROXY_HOPS=0
# H4 (docs/DECISIONS.md, PROD-H4-01): allowlist EXPLICITA e opcional de origens cross-origin confiaveis
# para CORS — o Patrono e same-origin por padrao (nenhuma origem adicional e necessaria hoje). Formato:
# lista separada por virgulas de origens EXATAS (scheme+host+porta), ex.:
# "https://app.exemplo.com,https://admin.exemplo.com". Vazia/ausente (padrao) = nenhuma origem
# cross-origin adicional confiada; requisicoes same-origin continuam funcionando normalmente. Nunca usa
# wildcard nem reflete automaticamente qualquer Origin recebida.
# Correcao pos-H4 (mesma decisao PROD-H4-01): cada entrada e normalizada (barra final ignorada, host
# tratado sem diferenciar maiusculas/minusculas, porta padrao do esquema omitida) antes da comparacao —
# uma entrada com caminho/query/hash (ex.: "https://app.exemplo.com/algo") e REJEITADA por inteiro
# (fail-closed), nunca truncada silenciosamente para a origem. Em producao, qualquer entrada malformada
# aqui interrompe o boot explicitamente (nunca e ignorada silenciosamente); fora de producao a entrada
# invalida e apenas descartada, sem travar desenvolvimento/teste.
CORS_ALLOWED_ORIGINS=
# H5 (docs/DECISIONS.md, PROD-H5-01): identidade de ambiente EXPLICITA para backup/restore do
# PostgreSQL canonico — independente de NODE_ENV (que so distingue producao de nao-producao para o
# runtime do servidor). Valores aceitos: production|staging|development. Se ausente, deriva de NODE_ENV
# (production->production, qualquer outro->development) — nunca assume producao por engano.
APP_ENVIRONMENT=development
# H5: provider de storage OFFSITE do backup do PostgreSQL. "filesystem" e um stand-in de
# desenvolvimento/teste (NUNCA aceito em producao — fail-fast se tentado); "s3" e o unico provider
# aceito em producao, compatível com qualquer storage S3-compatible (AWS S3, MinIO, Backblaze B2,
# Cloudflare R2, etc., via BACKUP_ENDPOINT). Vazio/ausente fora de producao usa "filesystem" por padrao.
BACKUP_STORAGE_PROVIDER=filesystem
# H5: diretorio local usado SOMENTE pelo provider "filesystem" (nunca em producao).
BACKUP_LOCAL_DIR=./data/backups-dev
# H5: configuracao do provider "s3" — obrigatorios quando BACKUP_STORAGE_PROVIDER=s3. BACKUP_ENDPOINT
# fica vazio para AWS S3 real; preencha para um storage S3-compatible com endpoint proprio.
# Correcao pos-H5 (revisao tecnica independente): em producao, se BACKUP_ENDPOINT estiver definido,
# deve usar https: — nunca http: (endpoint em texto claro exporia as credenciais de acesso ao storage).
# Fora de producao, um endpoint HTTP local (MinIO/testes) continua permitido.
BACKUP_BUCKET=
BACKUP_REGION=
BACKUP_ENDPOINT=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
# H5: chave de criptografia application-side do artefato de backup do PostgreSQL (AES-256-GCM),
# independente de COEVO_BACKUP_KEY (que so cifra o snapshot JSON legado de /api/backup — nunca reaproveitada
# aqui, para nao acoplar a rotacao de uma chave a da outra). Minimo de 32 caracteres se definida; deve
# ficar VAZIA neste arquivo de exemplo, gerar um valor unico por ambiente, nunca versionado.
# Correcao pos-H5 (revisao tecnica independente): OBRIGATORIA em producao (APP_ENVIRONMENT=production) —
# ate existir validacao real de SSE/KMS do provider de storage, um backup de producao em texto claro
# nunca e aceito; o script falha explicitamente no boot se ausente/curta. Fora de producao continua
# opcional (para nao travar desenvolvimento/teste local).
BACKUP_ENCRYPTION_KEY=
# H5: variaveis usadas APENAS na hora do restore (scripts/restore-postgres.js), nunca no boot do
# servidor. DATABASE_URL_TARGET e RESTORE_TARGET_ENVIRONMENT sao sempre obrigatorias explicitamente —
# o restore nunca assume um banco "atual" implicitamente. RESTORE_CONFIRM_PRODUCTION so e exigida
# quando o alvo e producao (string longa e intencional, nunca um booleano trivial).
# RESTORE_ALLOW_CROSS_ENVIRONMENT e um override raro e auditavel para restaurar um backup de um
# ambiente diferente do alvo (bloqueado por padrao). RESTORE_REPLACE e exigida para restaurar por cima
# de um banco de destino que ja tenha dados (nunca sobrescreve silenciosamente).
DATABASE_URL_TARGET=
RESTORE_TARGET_ENVIRONMENT=
RESTORE_CONFIRM_PRODUCTION=
RESTORE_ALLOW_CROSS_ENVIRONMENT=
RESTORE_REPLACE=
RESTORE_OPERATOR=
MONDAY_TOKEN=
MONDAY_BOARD_PROCESSOS=5959705266
MONDAY_BOARD_NOTIFICACOES=5630368737
MONDAY_BOARD_DISTRATOS=18404493605
MONDAY_BOARD_HONORARIOS=7231876117
MONDAY_BOARD_UNIDADES=18410779605
MONDAY_BOARD_COMPRA_VENDA=5821473011
MONDAY_BOARD_TRANSFERENCIA_INTERMEDIARIA=6149480325
MONDAY_SYNC_TIMES=08:00,13:00,18:00
# H6 (docs/DECISIONS.md, PROD-H6-01): observabilidade estruturada. Todos providers-neutros — nenhum
# valor aqui acopla a aplicacao a um SaaS pago especifico.
# Nivel minimo de log emitido. Producao usa "info" por padrao (nunca "debug"); valores aceitos:
# debug|info|warn|error|fatal. Valor invalido em producao usa fallback seguro (info), nunca degrada
# para debug.
LOG_LEVEL=info
# Formato de saida do logger. Hoje sempre JSON estruturado (uma linha por evento); campo reservado para
# eventual modo legivel em desenvolvimento futuro — nao altera o comportamento do logger nesta rodada.
LOG_FORMAT=json
# Nome logico do servico, incluido em todo evento estruturado (campo "service").
SERVICE_NAME=patrono-alta-performance
# H6: destino de alerta via webhook HTTPS generico (nunca acoplado a um provedor especifico). Vazio/
# ausente (padrao) = alerta desabilitado — a aplicacao continua funcionando normalmente, mas o
# monitoramento externo fica incompleto (documentado em docs/OBSERVABILITY.md; nunca trava o boot por
# ausencia). Em producao, se definida, DEVE usar https:.
ALERT_WEBHOOK_URL=
# H6: chave HMAC-SHA256 opcional para assinar o payload do webhook (header X-Patrono-Signature). Deve
# ficar VAZIA neste arquivo de exemplo, gerar um valor unico por ambiente, nunca versionado.
ALERT_WEBHOOK_HMAC_KEY=
# H6: nivel minimo de severidade que dispara o webhook de alerta (debug|info|warn|error|fatal). Padrao
# "error" — eventos abaixo disso nunca disparam alerta externo, mesmo que fiquem no log.
ALERT_MIN_LEVEL=error
# H6: janela de cooldown/dedup (ms) por chave de alerta, para nunca disparar uma tempestade de alertas
# repetidos para o mesmo evento. Best-effort, em memoria, POR INSTANCIA (nunca uma garantia de dedup
# global entre multiplas instancias — ver docs/OBSERVABILITY.md). So e marcado APOS uma entrega de
# alerta bem-sucedida — uma tentativa que falha nunca deixa o cooldown "ativo" para um alerta que nunca
# chegou a sair (correcao pos-H6, revisao tecnica final).
ALERT_COOLDOWN_MS=300000
# H6 (correcao pos-implementacao, revisao tecnica final): threshold real de HTTP 5xx repetido antes de
# emitir o alerta `repeated_http_5xx` — um 500 isolado NUNCA alerta (so e logado normalmente em ERROR);
# so ao acumular HTTP_5XX_ALERT_THRESHOLD ocorrencias na mesma rota normalizada dentro da janela
# HTTP_5XX_ALERT_WINDOW_MS o alerta e disparado (uma unica vez por janela). Estado em memoria, por
# instancia, best-effort — nunca persistido, nunca confundido com o rate limiting real de H3
# (auth/rate-limit.js, distribuido via PostgreSQL).
HTTP_5XX_ALERT_THRESHOLD=5
HTTP_5XX_ALERT_WINDOW_MS=300000
# H7 (docs/DECISIONS.md, PROD-H7-01; docs/INCIDENT_RESPONSE.md): canal de comunicacao de incidente e
# contatos de seguranca/privacidade. Deliberadamente VAZIOS neste arquivo de exemplo — nenhum canal
# real (Slack/Teams/e-mail/telefone) e inventado ou versionado. A parametrizacao real e uma decisao
# operacional pre-producao (ver docs/INCIDENT_RESPONSE.md, secao 15 — enquanto vazio, PG-20 permanece
# aberto).
INCIDENT_PRIMARY_CHANNEL=
INCIDENT_SECONDARY_CHANNEL=
INCIDENT_SECURITY_CONTACT=
INCIDENT_PRIVACY_CONTACT=
# H8 (docs/DECISIONS.md, PROD-H8-01; docs/DATA_RETENTION.md): prazos de retencao por classe de dado.
# Nenhum e obrigatorio — ausente, usa o default de politica interna documentado em docs/DATA_RETENTION.md
# (NUNCA uma obrigacao legal especifica, apenas um ponto de partida operacional). Um valor definido mas
# invalido (nao-inteiro/<=0) falha explicitamente ao executar retencao real — nunca e ignorado em
# silencio.
RETENTION_SECURITY_AUDIT_DAYS=
RETENTION_BUSINESS_AUDIT_DAYS=
RETENTION_EXPIRED_SESSION_DAYS=
RETENTION_RATE_LIMIT_HOURS=
RETENTION_BACKUP_METADATA_DAYS=
RETENTION_RESTORE_METADATA_DAYS=
RETENTION_INCIDENT_RECORD_DAYS=
RETENTION_OPERATIONAL_LOG_DAYS=
# H8: confirmacao adicional obrigatoria para executar `node scripts/run-retention.js --execute` EM
# PRODUCAO (mesmo padrao de RESTORE_CONFIRM_PRODUCTION, H5) — sem ela, a execucao real e recusada mesmo
# com --execute. Fora de producao, dry-run/execute funcionam sem esta variavel. Deve ficar VAZIA neste
# arquivo de exemplo — nunca um segredo fixo, e uma confirmacao operacional explicita do operador.
RETENTION_EXECUTE_CONFIRMATION=
# H8 (docs/DECISIONS.md, PROD-H8-03): chave HMAC-SHA256 para pseudonimizar o IP do requisitante em
# eventos de auditoria (audit_log.ip_hmac) — NUNCA um hash sem segredo, NUNCA o IP em texto puro. Se o
# recurso for exercitado (rota nova de H8 chamando buildAuditContext) e esta chave estiver ausente EM
# PRODUCAO, a aplicacao falha explicitamente ao pseudonimizar (fail-fast) em vez de gravar o IP em claro.
# Deve ficar VAZIA neste arquivo de exemplo — gerar um valor unico por ambiente, nunca versionado, mesma
# exigencia de MFA_ENCRYPTION_KEY/COEVO_BACKUP_KEY/RATE_LIMIT_HMAC_KEY acima.
AUDIT_IP_HMAC_KEY=
