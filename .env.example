NODE_ENV=development
PORT=3007
DATABASE_URL=postgresql://coevo_app:ALTERE_A_SENHA@localhost:5432/coevo_alta_performance
DATABASE_SSL=false
# A partir de H2 (docs/DECISIONS.md, PROD-H2-01): nao e mais uma senha/codigo global comparado no login
# (isso foi removido). Fora de producao, COEVO_DEMO_PASSWORD e reaproveitada apenas como fonte da senha
# de conveniencia atribuida a usuarios seed/legados de desenvolvimento e teste; COEVO_MFA_CODE nao e mais
# lida em nenhum ponto do runtime (mantida aqui so por compatibilidade de .env existentes).
COEVO_DEMO_PASSWORD=defina-uma-senha-local-forte
COEVO_MFA_CODE=defina-um-codigo-temporario
COEVO_SESSION_MS=3600000
# Obrigatorio para /api/backup. Minimo de 32 caracteres.
# Deve ficar VAZIO neste arquivo de exemplo: um valor preenchido aqui seria
# publico e funcional, tornando os backups decifraveis por qualquer pessoa
# com acesso ao repositorio. Gere um valor unico por ambiente e defina-o
# somente no .env local (nao versionado), por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COEVO_BACKUP_KEY=
# H2 (docs/DECISIONS.md, PROD-H2-01): obrigatoria para cifrar/decifrar o segredo TOTP de MFA em
# repouso (AES-256-GCM). Mesma exigencia de COEVO_BACKUP_KEY acima: minimo de 32 caracteres, deve ficar
# VAZIO neste arquivo de exemplo, gerar um valor unico por ambiente, nunca versionado.
MFA_ENCRYPTION_KEY=
# H2: overrides OPCIONAIS, usados apenas fora de producao (NODE_ENV != production), para a senha/segredo
# TOTP de conveniencia atribuidos a usuarios seed/legados de desenvolvimento e teste. Nunca aplicados
# automaticamente em producao. Deixar vazio usa o valor padrao de desenvolvimento embutido no codigo.
COEVO_SEED_PASSWORD=
COEVO_SEED_TOTP_SECRET=
MONDAY_TOKEN=
MONDAY_BOARD_PROCESSOS=5959705266
MONDAY_BOARD_NOTIFICACOES=5630368737
MONDAY_BOARD_DISTRATOS=18404493605
MONDAY_BOARD_HONORARIOS=7231876117
MONDAY_BOARD_UNIDADES=18410779605
MONDAY_BOARD_COMPRA_VENDA=5821473011
MONDAY_BOARD_TRANSFERENCIA_INTERMEDIARIA=6149480325
MONDAY_SYNC_TIMES=08:00,13:00,18:00
